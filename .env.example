# AI听觉康复助手环境变量配置
# 请复制此文件为 .env 并填写实际值

# 数据库配置
POSTGRES_DB=cochlear_rehab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# 后端配置
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_local_password@localhost:5432/cochlear_rehab
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long

# AI服务
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 其他配置
APP_NAME=AI听觉康复助手
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
