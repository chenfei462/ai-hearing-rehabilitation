# 后端直接运行时复制为 backend/.env；Docker Compose 使用项目根目录 .env。

DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_local_password@localhost:5432/cochlear_rehab
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
DASHSCOPE_API_KEY=
APP_NAME=AI听觉康复助手
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
