# =============================================================================
# AI 听觉康复助手 - 后端环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 配置优先级：环境变量 > .env 文件 > 代码默认值
# =============================================================================

# ── 基础信息 ─────────────────────────────────────────────
# APP_NAME=AI听觉康复助手
# APP_VERSION=0.1.0
# DEBUG=true

# ── 数据库 ───────────────────────────────────────────────
# PostgreSQL 异步连接字符串
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cochlear_rehab

# ── Redis ────────────────────────────────────────────────
# Redis 连接地址，用于对话上下文缓存
REDIS_URL=redis://localhost:6379/0

# ── JWT 认证 ─────────────────────────────────────────────
# 【必填】JWT 签名密钥，禁止使用默认值！
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# JWT 签名算法（默认 HS256）
# ALGORITHM=HS256

# Token 有效期（天，默认 7）
# ACCESS_TOKEN_EXPIRE_DAYS=7

# ── AI 服务 (阿里云百炼) ─────────────────────────────────
# 【必填】阿里云百炼 API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# ASR 语音识别配置
# ASR_MODEL=paraformer-v2
# ASR_TIMEOUT=10
# ASR_MAX_RETRIES=3
# ASR_RETRY_DELAY=1.0

# TTS 语音合成配置
# TTS_MODEL=qwen3-tts
# TTS_DEFAULT_VOICE=zhixiaoxuan
# TTS_TIMEOUT=15
# TTS_MAX_RETRIES=3
# TTS_RETRY_DELAY=1.0
# TTS_CACHE_TTL=604800

# LLM 大语言模型配置
# LLM_MODEL=qwen-turbo
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY=1.0
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# ── OSS 对象存储（TTS 缓存音频上传）─────────────────────
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=cochlear-rehab-audio
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou

# ── CORS 跨域配置 ───────────────────────────────────────
# 允许的前端地址，逗号分隔
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
